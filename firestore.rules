rules_version = '2';
// All collections (notebookReservations, notebookAudit, notebookMeta,
// notebookRequests, notebookImports, notebookRateLimits) are server-only.
// Browser operations, including supervisors, pass through the validated API.
// Admin SDK bypasses rules and is restricted with IAM and API authorization.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
  }
}
